3. Basic SQL
1. SELECT + WHERE
SELECT * FROM students WHERE city = 'Delhi';

2. DISTINCT
SELECT DISTINCT city FROM students;

3. ORDER BY
SELECT * FROM students ORDER BY age DESC;

4. LIMIT
SELECT * FROM students LIMIT 2;

4. Joins
INNER JOIN
SELECT s.name, c.course_name, e.marks
FROM enrollments e
INNER JOIN students s ON e.student_id = s.id
INNER JOIN courses c ON e.course_id = c.id;

LEFT JOIN
SELECT s.name, e.marks
FROM students s
LEFT JOIN enrollments e ON s.id = e.student_id;

5. Grouping & Aggregation
Average marks per course
SELECT c.course_name, AVG(e.marks) AS avg_marks
FROM enrollments e
JOIN courses c ON e.course_id = c.id
GROUP BY c.course_name;

HAVING (filter groups)
SELECT c.course_name, AVG(e.marks) AS avg_marks
FROM enrollments e
JOIN courses c ON e.course_id = c.id
GROUP BY c.course_name
HAVING AVG(e.marks) > 80;

6. String Functions
SELECT UPPER(name) AS upper_name,
       LENGTH(name) AS name_length
FROM students;

7. Date Functions
SELECT sale_date,
      EXTRACT(MONTH FROM sale_date) AS sale_month
FROM sales;

SELECT DATEDIFF(CURDATE(), sale_date) FROM sales;

8. Subqueries
Students scoring above average
SELECT name FROM students
WHERE id IN (SELECT student_id FROM enrollments
    WHERE marks > (SELECT AVG(marks) FROM enrollments)
);
EXISTS
SELECT name FROM students s
WHERE EXISTS (
    SELECT 1 FROM enrollments e WHERE e.student_id = s.id
);
9. Window Functions
Rank students by marks
SELECT s.name, e.marks,
       RANK() OVER (ORDER BY e.marks DESC) AS rank_no
FROM enrollments e
JOIN students s ON e.student_id = s.id;

10. Set Operations
Cities of students or customers

(Example assuming customers table)
SELECT city FROM students
UNION
SELECT city FROM customers;

11. Case When (Conditional)
SELECT name, marks,
CASE 
    WHEN marks >= 90 THEN 'A'
    WHEN marks >= 75 THEN 'B'
    ELSE 'C'
END AS grade
FROM enrollments e
JOIN students s ON e.student_id = s.id;
