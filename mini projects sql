1. CREATE DATABASE & TABLES
CREATE DATABASE school_system;
USE school_system;

TABLE 1: students
CREATE TABLE students (
    id INT PRIMARY KEY,
    name VARCHAR(50),
    age INT,
    city VARCHAR(50)
);

TABLE 2: courses
CREATE TABLE courses (
    id INT PRIMARY KEY,
    course_name VARCHAR(50),
    fees INT
);
TABLE 3: enrollments
CREATE TABLE enrollments (
    id INT PRIMARY KEY,
    student_id INT,
    course_id INT,
    marks INT,
FOREIGN KEY (student_id) REFERENCES students(id),
    FOREIGN KEY (course_id) REFERENCES courses(id)
);
TABLE 4: products
CREATE TABLE products (
    id INT PRIMARY KEY,
    name VARCHAR(50),
    category VARCHAR(50),
    price INT
);
TABLE 5: sales
CREATE TABLE sales (
    id INT PRIMARY KEY,
    product_id INT,
    quantity INT,
    sale_date DATE,
    FOREIGN KEY (product_id) REFERENCES products(id)
);

